{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartTunnelToTheBastionOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT>:instance/<BASTION_ID>",
        "arn:aws:ssm:<REGION>::document/AWS-StartPortForwardingSessionToRemoteHost"
      ]
    },
    {
      "Sid": "TerminateOwnSessions",
      "Effect": "Allow",
      "Action": "ssm:TerminateSession",
      "Resource": "arn:aws:ssm:*:*:session/${aws:userid}-*"
    },
    {
      "Sid": "SeeIfTheBastionIsOnline",
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*"
    },
    {
      "Sid": "ReadTheProjectParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:<REGION>:<ACCOUNT>:parameter/<PROJECT>/*/<STAGE>/*"
    },
    {
      "Sid": "ReadTheDatabaseSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:<REGION>:<ACCOUNT>:secret:<DB_SECRET>-*"
    }
  ]
}
