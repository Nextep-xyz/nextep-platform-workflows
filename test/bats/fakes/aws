#!/usr/bin/env bash
# Fake `aws` CLI for the bats tests. Behaviour is driven by FAKE_* variables; every call is appended to $FAKE_LOG.
echo "aws $*" >>"${FAKE_LOG:-/dev/null}"
arg_after() { # arg_after <flag>
  local i args=("${ALL_ARGS[@]}")
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ ${args[i]} == "$1" ]]; then printf '%s' "${args[i + 1]}"; return; fi
  done
}
ALL_ARGS=("$@")
# With FAKE_AWS_ENV_LOG set, records which credentials every CodeArtifact call ran with (the registry-login tests prove they come from
# the assumed role, and only there).
if [[ -n ${FAKE_AWS_ENV_LOG:-} && $1 == codeartifact ]]; then
  echo "$2 key=${AWS_ACCESS_KEY_ID:-} secret=${AWS_SECRET_ACCESS_KEY:-} session=${AWS_SESSION_TOKEN:-}" >>"$FAKE_AWS_ENV_LOG"
fi
case "$1 $2" in
  "sts assume-role-with-web-identity")
    if [[ -n ${FAKE_STS_ASSUME_FAIL:-} ]]; then echo "AccessDenied: not authorized to perform sts:AssumeRoleWithWebIdentity" >&2; exit 254; fi
    [[ -n $(arg_after --web-identity-token) && -n $(arg_after --role-arn) ]] || { echo "fake aws: assume-role-with-web-identity without a token or a role" >&2; exit 2; }
    printf '{"Credentials": {"AccessKeyId": "%s", "SecretAccessKey": "%s", "SessionToken": "%s", "Expiration": "2030-01-01T00:00:00+00:00"}}
' "${FAKE_STS_KEY-ASIAFAKEKEY0001}" "${FAKE_STS_SECRET-fake-sts-secret-Hq29Zr}" "${FAKE_STS_SESSION-fake-sts-session-Lm73Wd}"
    ;;
  "ssm get-parameter")
    if [[ " ${FAKE_MISSING:-} " == *" $(arg_after --name) "* ]]; then echo "ParameterNotFound" >&2; exit 254; fi
    case "$(arg_after --name)" in
      */ssm-values/*) echo "${FAKE_SSM_VALUE-ssm-secret-value}" ;;
      *cluster*) echo "shop-cluster" ;;
      *service*) echo "shop-service" ;;
      *bastion*) printf '%s\n' "${FAKE_BASTION_ID-i-0abc123}" ;;
      *endpoint*) printf '%s\n' "${FAKE_DB_ENDPOINT-db.example.internal}" ;;
      *) echo "value" ;;
    esac
    ;;
  "ssm describe-instance-information") printf '%s\n' "${FAKE_PING-Online}" ;;
  "secretsmanager get-secret-value")
    if [[ -n ${FAKE_SECRET_FAIL:-} ]]; then echo "AccessDeniedException" >&2; exit 254; fi
    printf '%s\n' "${FAKE_SECRET_JSON-}"
    ;;
  "ssm start-session")
    case "${FAKE_TUNNEL:-listen}" in
      die) echo "TargetNotConnected: the tunnel could not be established" >&2; exit 1 ;;
      listen)
        exec "${FAKE_PYTHON:-python3}" -c 'import socket,sys,time
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", int(sys.argv[1]))); s.listen(5); time.sleep(120)' "${FAKE_PORT:?}"
        ;;
    esac
    ;;
  "sts get-caller-identity")
    if [[ -n ${FAKE_STS_FAIL:-} ]]; then echo "ExpiredToken" >&2; exit 254; fi
    printf '%s
' "${FAKE_ACCOUNT-$(printf '%012d' 7)}"
    ;;
  "ecr describe-images")
    if [[ -n ${FAKE_ECR_ERROR:-} ]]; then echo "$FAKE_ECR_ERROR" >&2; exit 254; fi
    if [[ -n ${FAKE_ECR_MISSING:-} ]]; then echo "ImageNotFoundException" >&2; exit 254; fi
    echo "tag"
    ;;
  "ecs update-service") echo "shop-service" ;;
  "secretsmanager describe-secret")
    if [[ " ${FAKE_MISSING:-} " == *" $(arg_after --secret-id) "* ]]; then echo "ResourceNotFoundException" >&2; exit 254; fi
    echo ok
    ;;
  "codeartifact get-authorization-token")
    if [[ -n ${FAKE_CA_TOKEN_FAIL:-} ]]; then echo "AccessDeniedException" >&2; exit 254; fi
    printf '{"authorizationToken": "%s", "expiration": "2030-01-01T00:00:00+00:00"}
' "${FAKE_CA_TOKEN-fake-ca-token-Zq81xK}"
    ;;
  "codeartifact get-repository-endpoint")
    printf '{"repositoryEndpoint": "%s"}
' "${FAKE_CA_ENDPOINT-https://example-domain-$(printf '%012d' 7).d.codeartifact.us-east-2.amazonaws.com/npm/example-repo/}"
    ;;
  "codeartifact describe-package-version")
    if [[ -n ${FAKE_CA_DESCRIBE_FAIL:-} ]]; then echo "AccessDeniedException" >&2; exit 254; fi
    # the version exists when FAKE_CA_EXISTS is set, or once the fake npm published it (FAKE_CA_STATE marker)
    if [[ -n ${FAKE_CA_EXISTS:-} || -f ${FAKE_CA_STATE:-/nonexistent} ]]; then
      printf '{"packageVersion": {"format": "npm", "version": "%s", "status": "%s"}}
' "$(arg_after --package-version)" "${FAKE_CA_STATUS-Published}"
    else
      echo "ResourceNotFoundException: package version not found" >&2
      exit 254
    fi
    ;;
  *) echo "fake aws: unhandled call: $*" >&2; exit 2 ;;
esac
