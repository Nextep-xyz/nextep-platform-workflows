# Pinned downloads used at deploy time by the SSM tunnel (never "latest", never unverified).
# Bump version AND sha256 together, in one commit, after checking the new artifact by hand.
# sha256 values were taken from the artifacts downloaded on 2026-11-09 (trust on first use).

# AWS Session Manager plugin (Ubuntu 64-bit .deb)
SSM_PLUGIN_VERSION=1.2.896.0
SSM_PLUGIN_URL=https://s3.amazonaws.com/session-manager-downloads/plugin/1.2.896.0/ubuntu_64bit/session-manager-plugin.deb
SSM_PLUGIN_SHA256=53f51fcc67314a4bf85888a38a3967cd41f8d0f28a60a9469a63acf935ba713e

# Amazon RDS global CA bundle (certificate verification for sslmode=verify-full)
RDS_CA_BUNDLE_URL=https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
RDS_CA_BUNDLE_SHA256=90a6f1a7978a1b1b096dca6c57511ca48d3b8cf052f8e704baf358f34ea2f21b
