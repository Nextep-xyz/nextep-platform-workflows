{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/telemetry.schema.json",
  "title": "DeploymentTelemetry",
  "description": "Payload of the deployment event sent by the telemetry-phone-home job (docs/specs/telemetria-dora/SPEC.md). Closed: additionalProperties false at every level. Same schema as the collector (canonical hash in telemetry.schema.sha256).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "idempotency_key",
    "emitted_at",
    "workflow",
    "source",
    "target",
    "result",
    "stages",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "deployment"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:[0-9]+:[0-9]+$"
    },
    "emitted_at": {
      "$ref": "#/definitions/timestamp"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version_ref",
        "sha",
        "run_attempt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^lego-[a-z0-9-]+$",
          "maxLength": 64
        },
        "version_ref": {
          "type": "string",
          "maxLength": 100
        },
        "sha": {
          "$ref": "#/definitions/sha"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "repository",
        "ref",
        "sha",
        "tree_sha",
        "ancestry",
        "event_name",
        "run_id",
        "run_url"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha": {
          "$ref": "#/definitions/sha"
        },
        "tree_sha": {
          "$ref": "#/definitions/sha"
        },
        "ancestry": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha",
              "at"
            ],
            "properties": {
              "sha": {
                "$ref": "#/definitions/sha"
              },
              "at": {
                "$ref": "#/definitions/timestamp"
              }
            }
          }
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://[A-Za-z0-9.-]+/[^\\s]*$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "cloud",
        "environment",
        "region",
        "service",
        "kind"
      ],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,15}$"
        },
        "cloud": {
          "enum": [
            "aws",
            "azure"
          ]
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image_tag": {
          "type": "string",
          "maxLength": 200
        },
        "previous_image_tag": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failed_stage",
        "rollback",
        "circuit_breaker_triggered"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "failure",
            "cancelled"
          ]
        },
        "failed_stage": {
          "enum": [
            "gate",
            "migration",
            "deploy",
            null
          ]
        },
        "rollback": {
          "type": "boolean"
        },
        "circuit_breaker_triggered": {
          "type": "boolean"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gate": {
          "$ref": "#/definitions/stage"
        },
        "migration": {
          "$ref": "#/definitions/stage"
        },
        "deploy": {
          "$ref": "#/definitions/stage"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_at",
        "started_at",
        "finished_at",
        "duration_s"
      ],
      "properties": {
        "commit_at": {
          "$ref": "#/definitions/timestamp"
        },
        "started_at": {
          "$ref": "#/definitions/timestamp"
        },
        "finished_at": {
          "$ref": "#/definitions/timestamp"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "duration_s"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "failure",
            "skipped",
            "cancelled"
          ]
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "none",
            "ssm-tunnel",
            "ecs-task",
            "aca-job"
          ]
        }
      }
    }
  }
}
